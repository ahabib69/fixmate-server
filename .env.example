# Server port (local dev)
PORT=5000

# MongoDB connection string (same DB the Next.js client uses)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<dbname>?retryWrites=true&w=majority

# Must match JWT_SECRET in fixmate-client/.env.local
JWT_SECRET=change-me-to-a-long-random-string

# Stripe test keys (https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=sk_test_...

# Webhook signing secret - from `stripe listen` locally or the Stripe dashboard in production
STRIPE_WEBHOOK_SECRET=whsec_...

# Public URL of the Next.js client (comma separated if you have more than one)
CLIENT_URL=http://localhost:3000
